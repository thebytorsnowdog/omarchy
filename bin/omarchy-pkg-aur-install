#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking new AUR packages to install.
# omarchy:requires-sudo=true

fzf_args=(
  --multi
  --preview 'yay -Siia {1}'
  --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
  --bind 'alt-B:change-preview:yay -Siia {1}'
  --color 'pointer:green,marker:green'
)

pkg_names=$(yay -Slqa | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  # PKGBUILDs are third-party code. Drop any cached sudo timestamp and pass
  # yay a sudo that authenticates without refreshing it, as omarchy-update
  # does before its AUR phase. A keepalive across yay would let a PKGBUILD
  # call sudo with no further prompt.
  sudo_wrapper="$OMARCHY_PATH/default/omarchy/sudo-no-update/sudo"
  if [[ ! -x $sudo_wrapper ]]; then
    echo "omarchy-pkg-aur-install: missing sudo boundary wrapper." >&2
    exit 1
  fi
  sudo -k || exit 1

  echo "$pkg_names" | sed 's/^/aur\//' | tr '\n' ' ' | xargs \
    env PATH="$OMARCHY_PATH/default/omarchy/sudo-no-update:$PATH" \
    yay --sudo "$sudo_wrapper" --sudoloop=false -S --noconfirm
  code=$?
  sudo -k || true
  sudo updatedb --prune-bind-mounts=no --add-prunepaths=/.snapshots
  omarchy-show-done $code
fi
